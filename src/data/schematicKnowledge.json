          "name": "5V distribution",
          "type": "power",
          "width": 1.5
        }
      ],
      "commonFaults": [
        {
          "fault": "No power",
          "suspectedComponent": "U5000",
          "testMethod": "Voltage measurement",
          "expectedValue": "19V",
          "measuredValue": "0V",
          "repairAction": "Check power controller"
        },
        {
          "fault": "19V short",
          "suspectedComponent": "C5001",
          "testMethod": "Diode mode",
          "expectedValue": "Open",
          "measuredValue": "0.000V",
          "repairAction": "Replace shorted capacitor"
        }
      ]
    }
  ],
