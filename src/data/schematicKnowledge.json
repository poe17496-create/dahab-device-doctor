          "x": 30,
          "y": 35,
          "type": "voltage",
          "status": "normal"
        }
      ],
      "circuitTraces": [
        {
          "id": "trace-007",
          "from": { "x": 15, "y": 20 },
          "to": { "x": 20, "y": 25 },
          "name": "19V input",
          "type": "power",
          "width": 3
        },
        {
          "id": "trace-008",
          "from": { "x": 20, "y": 25 },
          "to": { "x": 25, "y": 30 },
          "name": "19V to converter",
          "type": "power",
          "width": 2
        },
        {
          "id": "trace-009",
          "from": { "x": 25, "y": 30 },
