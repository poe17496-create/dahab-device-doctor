{
  "schematics": [
    {
      "id": "iphone-11-vcc-main",
      "name": "iPhone 11 - VCC_MAIN Circuit",
      "description": "Main power distribution circuit for iPhone 11",
      "device": "iPhone 11",
      "boardNumber": "A2111 / A2113 / A2118",
      "components": [
        {
          "name": "U2000",
          "type": "IC",
          "description": "PMIC - Power Management IC",
          "package": "BGA",
          "pins": 196,
          "function": "Main power distribution and voltage regulation"
        },
        {
          "name": "C2015",
          "type": "Capacitor",
          "description": "VCC_MAIN filter capacitor",
          "package": "0402",
          "value": "10μF",
          "function": "Filter VCC_MAIN rail"
        },
        {
          "name": "C2016",
          "type": "Capacitor",
          "description": "VCC_MAIN filter capacitor",
          "package": "0402",
          "value": "10μF",
          "function": "Filter VCC_MAIN rail"
        },
        {
          "name": "Q2010",
          "type": "MOSFET",
          "description": "VCC_MAIN power switch",
          "package": "WLCSP",
          "function": "Control VCC_MAIN flow"
        },
        {
          "name": "R2015",
          "type": "Resistor",
          "description": "VCC_MAIN current sense",
          "package": "0201",
          "value": "0.1Ω",
          "function": "Current sensing"
        }
      ],
      "testPoints": [
        {
          "id": "tp-001",
          "name": "VCC_MAIN",
          "component": "C2015",
          "expectedValue": "4.2V",
          "measurement": "0V",
          "instruction": "Measure voltage at C2015 with multimeter in DC mode",
          "x": 25,
          "y": 30,
          "type": "voltage",
          "status": "critical"
        },
        {
          "id": "tp-002",
          "name": "PP_VCC_MAIN",
          "component": "C2016",
          "expectedValue": "4.2V",
          "measurement": "0V",
          "instruction": "Check PP_VCC_MAIN rail at C2016",
          "x": 30,
          "y": 35,
          "type": "voltage",
          "status": "critical"
        },
        {
          "id": "tp-003",
          "name": "PP_BATT_VCC",
          "component": "Q2010",
          "expectedValue": "4.2V",
          "measurement": "4.2V",
          "instruction": "Verify battery voltage input",
          "x": 35,
          "y": 40,
          "type": "voltage",
          "status": "normal"
        }
      ],
      "circuitTraces": [
        {
          "id": "trace-001",
          "from": { "x": 20, "y": 25 },
          "to": { "x": 25, "y": 30 },
          "name": "VCC_MAIN input",
          "type": "power",
          "width": 2
        },
        {
          "id": "trace-002",
          "from": { "x": 25, "y": 30 },
          "to": { "x": 30, "y": 35 },
          "name": "VCC_MAIN distribution",
          "type": "power",
          "width": 1.5
        },
        {
          "id": "trace-003",
          "from": { "x": 30, "y": 35 },
          "to": { "x": 35, "y": 40 },
          "name": "VCC_MAIN to load",
          "type": "power",
          "width": 1
        }
      ],
      "commonFaults": [
        {
          "fault": "VCC_MAIN short",
          "suspectedComponent": "C2015 or C2016",
          "testMethod": "Diode mode measurement",
          "expectedValue": "Open",
          "measuredValue": "0.000V",
          "repairAction": "Replace shorted capacitor"
        },
        {
          "fault": "PMIC failure",
          "suspectedComponent": "U2000",
          "testMethod": "Voltage measurement",
          "expectedValue": "4.2V",
          "measuredValue": "0V",
          "repairAction": "Reball or replace U2000"
        }
      ]
    },
    {
      "id": "samsung-s21-battery",
      "name": "Samsung S21 - Battery Circuit",
      "description": "Battery charging and power management circuit",
      "device": "Samsung Galaxy S21",
      "boardNumber": "G991B / G991U",
      "components": [
        {
          "name": "U1000",
          "type": "IC",
          "description": "Charging IC - PMIC",
          "package": "BGA",
          "pins": 144,
          "function": "Battery charging control"
        },
        {
          "name": "C1001",
          "type": "Capacitor",
          "description": "VBAT filter",
          "package": "0402",
          "value": "10μF",
          "function": "Filter battery voltage"
        },
        {
          "name": "C1002",
          "type": "Capacitor",
          "description": "VCHG filter",
          "package": "0402",
          "value": "10μF",
          "function": "Filter charging voltage"
        },
        {
          "name": "Q1000",
          "type": "MOSFET",
          "description": "Battery power switch",
          "package": "WLCSP",
          "function": "Control battery power flow"
        }
      ],
      "testPoints": [
        {
          "id": "tp-004",
          "name": "VBAT",
          "component": "C1001",
          "expectedValue": "3.8V",
          "measurement": "3.8V",
          "instruction": "Measure battery voltage at C1001",
          "x": 20,
          "y": 25,
          "type": "voltage",
          "status": "normal"
        },
        {
          "id": "tp-005",
          "name": "VCHG",
          "component": "C1002",
          "expectedValue": "5V",
          "measurement": "0V",
          "instruction": "Check charging voltage at C1002",
          "x": 25,
          "y": 30,
          "type": "voltage",
          "status": "warning"
        },
        {
          "id": "tp-006",
          "name": "PP_5V_USB",
          "component": "Q1000",
          "expectedValue": "5V",
          "measurement": "5V",
          "instruction": "Verify USB 5V input",
          "x": 30,
          "y": 35,
          "type": "voltage",
          "status": "normal"
        }
      ],
      "circuitTraces": [
        {
          "id": "trace-004",
          "from": { "x": 15, "y": 20 },
          "to": { "x": 20, "y": 25 },
          "name": "Battery input",
          "type": "power",
          "width": 2
        },
        {
          "id": "trace-005",
          "from": { "x": 20, "y": 25 },
          "to": { "x": 25, "y": 30 },
          "name": "Battery to PMIC",
          "type": "power",
          "width": 1.5
        },
        {
          "id": "trace-006",
          "from": { "x": 25, "y": 30 },
          "to": { "x": 30, "y": 35 },
          "name": "Charging input",
          "type": "power",
          "width": 1
        }
      ],
      "commonFaults": [
        {
          "fault": "No charging",
          "suspectedComponent": "U1000",
          "testMethod": "Voltage measurement",
          "expectedValue": "5V",
          "measuredValue": "0V",
          "repairAction": "Check charging IC or replace"
        },
        {
          "fault": "Battery drain",
          "suspectedComponent": "Q1000",
          "testMethod": "Current measurement",
          "expectedValue": "< 50mA",
          "measuredValue": "500mA",
          "repairAction": "Replace MOSFET"
        }
      ]
    },
    {
      "id": "macbook-pro-19v",
