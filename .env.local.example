# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API Key (GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter API Key (GLM-5.2)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Backup)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary CDN (Optional - for image optimization)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Analytics (Optional - for tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook Pixel (Optional - for tracking)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=XXXXXXXXXXXXXXXX

# Google Search Console Verification (Optional - for SEO)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# Admin Password (Optional - if set, overrides default)
ADMIN_PASSWORD=X7#K9@mP2$Qw8!Rz5*Ln3
